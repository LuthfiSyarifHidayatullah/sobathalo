# =============================================================
# KONFIGURASI CHATBOT BKPSDM KABUPATEN BENGKAYANG
# =============================================================
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai.

# URL Google Apps Script Web App untuk pencatatan pertanyaan
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Token rahasia untuk autentikasi ke Google Apps Script
GOOGLE_SCRIPT_TOKEN=your_secret_token_here

# Timeout pengiriman data ke Google Spreadsheet (dalam detik)
GOOGLE_SCRIPT_TIMEOUT=10

# Path file CSV backup lokal
CSV_BACKUP_PATH=./data/log_backup.csv

# Path file database sesi WhatsApp
DB_PATH=./data/whatsapp.db
